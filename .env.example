# Vendor API keys — required to re-run the live benchmark.
# Vendors offer a free trial or self-serve plan that should be
# enough to score a single (seed, vendor) cell. The orchestrator only
# spends credits on cells you actually run.

OCEAN_API_KEY=
PARALLEL_API_KEY=
EXA_API_KEY=
EXTRUCT_API_TOKEN=
CUFINDER_API_KEY=
DISCOLIKE_API_KEY=
PREDICT_LEADS_API_KEY=
PREDICT_LEADS_API_TOKEN=

# LLM judge — the Q3 snapshot uses gpt-5.6 at high reasoning effort.
OPENAI_API_KEY=
# Optional override. The default in scripts/lookalike/judge.py remains compatible
# with older Azure deployments; set this to reproduce the published snapshot.
LOOKALIKE_JUDGE_MODEL=gpt-5.6

# Optional Azure-compatible judge endpoint configuration for alternate runs.
AZURE_OPENAI_NEXTGEN_DEPLOYMENT_KEY=
AZURE_OPENAI_NEXTGEN_DEPLOYMENT_URL=
