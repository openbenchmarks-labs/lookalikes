# Vendor API keys — required to re-run the live benchmark.
# All five vendors offer a free trial or self-serve plan that should be
# enough to score a single (seed, vendor) cell. The orchestrator only
# spends credits on cells you actually run.

OPENFUNNEL_API_KEY=
OCEAN_API_KEY=
PARALLEL_API_KEY=
EXA_API_KEY=
PREDICT_LEADS_API_KEY=
PREDICT_LEADS_API_TOKEN=

# LLM judge — defaults to Azure OpenAI gpt-5.4-mini. The Judge class
# accepts any OpenAI-v1 compatible endpoint. Swap base_url to point at
# a non-Azure model (OpenAI direct, local llama.cpp server, etc.) if
# you want to reproduce with a different judge to test bias.
AZURE_OPENAI_NEXTGEN_DEPLOYMENT_KEY=
AZURE_OPENAI_NEXTGEN_DEPLOYMENT_URL=
# Optional override of the (single) judge model id (defaults to gpt-5.4-mini).
# LOOKALIKE_JUDGE_MODEL=gpt-4o-mini

# Multi-judge panel: list model ids (--judges or LOOKALIKE_JUDGE_MODELS); a
# candidate is relevant by majority vote. Each model maps to its own deployment
# via JUDGE_ENDPOINTS in scripts/lookalike/judge.py — add its URL/KEY env vars.
# LOOKALIKE_JUDGE_MODELS=gpt-5.4-mini,gpt-5.2,o4-mini
# Judge prompt version: v1 (default) or v2 (improved rubric/category-aware).
# LOOKALIKE_JUDGE_PROMPT=v1
