# Vendor API keys — required to re-run the live benchmark.
# Vendors offer a free trial or self-serve plan that should be
# enough to score a single (seed, vendor) cell. The orchestrator only
# spends credits on cells you actually run.

OCEAN_API_KEY=
PARALLEL_API_KEY=
EXA_API_KEY=
EXTRUCT_API_TOKEN=
CUFINDER_API_KEY=
DISCOLIKE_API_KEY=
PREDICT_LEADS_API_KEY=
PREDICT_LEADS_API_TOKEN=
SELTZ_API_KEY=
COMPANY_ENRICH_API_KEY=

# Riveter builds the rows through its dataset API; keys at https://app.riveterhq.com/settings/api.
# Optional: RIVETER_API_BASE (default https://api.riveterhq.com/v1), RIVETER_BUILD_TIMEOUT_SEC (default 2400).
RIVETER_API_KEY=

# ZoomInfo has no entry here on purpose. Its similar-companies surface is not an
# HTTP API: the runner shells out to `gtm companies similar`, so reproducing
# those cells needs the GTM CLI on PATH rather than a key in this file. Sign-up
# is self-serve at gtm.ai and there is a free tier. Without the binary the
# runner fails that cell with "gtm CLI is not installed" rather than skipping it
# silently.

# ---------------------------------------------------------------------------
# LLM judge panel
# ---------------------------------------------------------------------------
# Version 2 (October 2026) is scored by three models from three independent labs:
# gpt-6-luna and glm-5.3-flash judge every candidate, and claude-haiku-5-5 is
# consulted only when they disagree; the majority verdict counts. All three keys are
# required to reproduce it; with only one you get a single-judge result that will
# not match the published numbers.

AZURE_OPENAI_NEXTGEN_DEPLOYMENT_KEY=   # gpt-6-luna (Azure OpenAI-v1 deployment)
AZURE_OPENAI_NEXTGEN_DEPLOYMENT_URL=
TELNYX_API_KEY=                        # glm-5.3-flash, served via Telnyx (OpenAI-compatible)
TELNYX_AI_BASE_URL=                    # optional; default https://api.telnyx.com/v2/ai/openai
ANTHROPIC_API_KEY=                     # claude-haiku-5-5

# The exact panel behind version 2. Comma-separated; order sets the order judges are
# consulted under gating (see LOOKALIKE_JUDGE_FULL_PANEL). Leave unset for the same
# default. Version 1 (2026 Q3) used claude-opus-5,gpt-5.6-terra,kimi-k3, which need
# OPENAI_API_KEY and FIREWORKS_API_KEY.
LOOKALIKE_JUDGE_MODELS=gpt-6-luna,glm-5.3-flash,claude-haiku-5-5

# Single-judge override. Only consulted when LOOKALIKE_JUDGE_MODELS is unset and
# no --judges flag is passed, so leave it empty to reproduce the panel.
LOOKALIKE_JUDGE_MODEL=

# ---------------------------------------------------------------------------
# Judge tuning (all optional — defaults reproduce the published run)
# ---------------------------------------------------------------------------
# Gating: with an odd panel the later judges are consulted only while the vote
# is still undecided, so the third model runs only when the first two disagree.
# Set to 1 to always run every judge, e.g. to measure per-model agreement.
LOOKALIKE_JUDGE_FULL_PANEL=

# Verdicts are cached on (judge, prompt version, seed, candidate) within a run,
# so a candidate returned by several vendors is scored once. Set to 1 to disable
# and measure judge variance instead.
LOOKALIKE_JUDGE_NO_CACHE=

# Judge fan-out. Set 1 to force sequential scoring.
LOOKALIKE_JUDGE_CONCURRENCY=

# Anthropic-specific knobs. Relevance is a gate-plus-check decision rather than a
# deep reasoning task, so the default effort is deliberately low.
ANTHROPIC_JUDGE_EFFORT=          # default: low
ANTHROPIC_JUDGE_MAX_TOKENS=      # default: 4096

